{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Kadre Docs",
  "colors": {
    "primary": "#96b5ca",
    "light": "#96b5ca",
    "dark": "#8099a9"
  },
  "favicon": {
