        {
          "anchor": "jaDev Documentation",
          "icon": "book-blank",
          "href": "https://docs.jadevelopment.co.uk/"
        },
        {
          "anchor": "Community",
          "icon": "discord",
          "href": "https://discord.com/invite/jadevelopment-962068926714511500"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/StandardKTypeface.png",
    "dark": "/images/JustTypefaceNoSubtext.png"
